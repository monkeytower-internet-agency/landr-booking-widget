# LANDR FastAPI base URL (no trailing slash)
# Dev (Trillian via Caddy): https://api.dev.landr.de
# Prod (GCP Cloud Run): https://landr-api-service-693721943357.europe-west3.run.app
VITE_API_BASE_URL=https://api.dev.landr.de

# Operator slug used when no ?operator= query param is present
VITE_DEFAULT_OPERATOR_SLUG=para42

# Set to "1" to skip the network and use in-memory fixtures (offline dev)
VITE_USE_MOCKS=0
